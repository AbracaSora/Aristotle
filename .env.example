# Copy to .env. API/seed/migration commands load the root .env; shell variables win.
# Development-only credentials; change all matching values for a shared deployment.
ARISTOTLE_DATABASE_URL=postgresql+psycopg://aristotle:aristotle-local@127.0.0.1:5433/aristotle
ARISTOTLE_POSTGRES_DB=aristotle
ARISTOTLE_POSTGRES_USER=aristotle
ARISTOTLE_POSTGRES_PASSWORD=aristotle-local
ARISTOTLE_POSTGRES_PORT=5433
ARISTOTLE_CORS_ORIGINS=http://localhost:5173,http://localhost:5179,http://127.0.0.1:5180,http://127.0.0.1:5181
# Local demonstration accounts only; set before the first --demo seed.
ARISTOTLE_DEMO_PASSWORD=demo-password

# OpenAI-compatible service roots ending in /v1. API keys stay in this ignored .env.
# No external calls occur merely by configuring a service; use explicit UI actions.
ARISTOTLE_LLM_BASE_URL=
ARISTOTLE_LLM_API_KEY=
ARISTOTLE_LLM_MODEL=qwen3.8-flash
ARISTOTLE_LLM_TOKEN_FIELD=max_tokens
ARISTOTLE_EMBEDDING_BASE_URL=
ARISTOTLE_EMBEDDING_API_KEY=
ARISTOTLE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Validate returned dimension, without assuming a provider supports dimension selection.
ARISTOTLE_EMBEDDING_DIMENSIONS=1024
ARISTOTLE_MODEL_TIMEOUT=30
ARISTOTLE_MODEL_RETRIES=0
ARISTOTLE_MODEL_DAILY_LIMIT=200
# Optional HTTP proxy for backend model calls; leave empty if unnecessary.
ARISTOTLE_MODEL_PROXY=
# With 0, run `python -m aristotle_backend.model_jobs` in a separate terminal.
ARISTOTLE_INLINE_WORKER=1
